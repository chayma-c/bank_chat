# ══════════════════════════════════════════════════════════════════════════════
# Text-to-SQL Service — Configuration
# ══════════════════════════════════════════════════════════════════════════════

# ── Service Configuration ─────────────────────────────────────────────────────
TEXT2SQL_PORT=8003

# ── Database Configuration ────────────────────────────────────────────────────
DATABASE_URL=postgresql://sql_user:sql_password@db:5432/banking_data

# ── SQL Execution Limits ──────────────────────────────────────────────────────
SQL_MAX_ROWS=100
SQL_TIMEOUT_MS=30000

# ── LLM Configuration (Groq) ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Keycloak Authentication ───────────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_REALM=myrealm
KEYCLOAK_CLIENT_ID=bank_chat
KEYCLOAK_ISSUER=http://localhost/auth

# ── CORS Configuration ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200,http://localhost,http://localhost:80
